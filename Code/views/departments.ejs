<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Τμήματα | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; }
        .dept-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            transition: 0.3s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .dept-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }
        .dept-photo {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }
        .dept-photo-placeholder {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor') { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } %>
                    <% if (role === 'doctor' || role === 'nurse') { %>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } %>
                    <% if (role === 'doctor') { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } %>
                    <% if (role === 'patient') { %>
                        <li class="nav-item"><a class="nav-link" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } %>
                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-building me-2"></i>Τμήματα Νοσοκομείου</h2>

        <div class="row g-4">
            <% departments.forEach(dept => { %>
                <div class="col-sm-6 col-md-4 col-lg-4">
                    <div class="dept-card">
                        <% if (dept.photo_url) { %>
                            <img src="<%= dept.photo_url %>" alt="<%= dept.name %>" class="dept-photo">
                        <% } else { %>
                            <div class="dept-photo-placeholder">
                                <i class="bi bi-hospital"></i>
                            </div>
                        <% } %>
                        <div class="p-3">
                            <h5 class="fw-bold mb-2"><%= dept.name %></h5>
                            <div class="small text-muted mb-2">
                                <i class="bi bi-layers me-1"></i><%= dept.floor_building %>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary"><%= dept.bed_count %> Κλίνες</span>
                            </div>
                            <div class="small">
                                <i class="bi bi-person-badge me-1 text-primary"></i>
                                <span class="fw-bold">Διευθυντής:</span>
                                <span class="text-muted"><%= dept.director_name || 'Δεν έχει οριστεί' %></span>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
