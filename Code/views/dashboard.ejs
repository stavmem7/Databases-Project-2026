<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Dashboard | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .card-stat { border-left: 5px solid; border-radius: 10px; transition: 0.2s; } /* Τέλος αγκύλης .card-stat */
        .card-stat:hover { transform: translateY(-5px); } /* Τέλος αγκύλης .card-stat:hover */
        .progress { background-color: #e9ecef; border-radius: 10px; height: 12px; } /* Τέλος αγκύλης .progress */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Τέλος ελέγχου γιατρού 1 */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } /* Τέλος if doctor 1 */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Τέλος ελέγχου προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if doctor || nurse */ %>

                    <% if (role === 'doctor' /* Τέλος ελέγχου γιατρού 2 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor 2 */ %>

                    <% if (role === 'patient' /* Τέλος ελέγχου ασθενή */) { %>
                        <li class="nav-item"><a class="nav-link" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } /* Τέλος if patient */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card card-stat border-primary shadow-sm h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ενεργοί Νοσηλευόμενοι</h6>
                            <h2 class="fw-bold mb-0"><%= stats.currentPatients %></h2>
                        </div>
                        <i class="bi bi-heart-pulse fs-1 text-primary"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card card-stat border-warning shadow-sm h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Σε Αναμονή (Triage)</h6>
                            <h2 class="fw-bold mb-0 text-warning"><%= stats.triageWaiting %></h2>
                        </div>
                        <i class="bi bi-clock-history fs-1 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-dark">Πληρότητα Κλινών ανά Τμήμα</h5>
                    </div>
                    <div class="card-body">
                        <% deptStats.forEach(dept => { 
                            let percent = dept.bed_count > 0 ? Math.round((dept.occupied_beds / dept.bed_count) * 100 /* Τέλος πράξης ποσοστού */) : 0;
                            let colorClass = percent > 80 ? 'bg-danger' : (percent > 50 ? 'bg-warning' : 'bg-success' /* Τέλος ternary χρώματος */);
                        /* Τέλος logic forEach */ %>
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-semibold"><%= dept.name %></span>
                                    <span class="text-muted small fw-bold text-uppercase"><%= dept.occupied_beds %>/<%= dept.bed_count %> ΚΛΙΝΕΣ</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar <%= colorClass %>" 
                                        role="progressbar" 
                                        style="--progress-width: <%= percent %>%; width: var(--progress-width);">
                                    </div>
                                </div>
                            </div>
                        <% }) /* Τέλος deptStats.forEach */ %>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-dark">Πρόσφατες Εισαγωγές</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <% if (recent.length > 0 /* Τέλος ελέγχου πρόσφατων */) { %>
                            <% recent.forEach(r => { /* Έναρξη πρόσφατων forEach */ %>
                                <div class="list-group-item p-3">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 fw-bold text-primary text-uppercase">
                                            <%= r.name %> <%= r.surname %>
                                        </h6>
                                        <small class="text-muted">
                                            <%= new Date(r.admission_date /* Τέλος Date */).toLocaleDateString('el-GR' /* Τέλος locale */) %>
                                        </small>
                                    </div>
                                    <p class="mb-0 small text-muted">
                                        <i class="bi bi-hospital me-1"></i><%= r.dept_name %>
                                    </p>
                                </div>
                            <% }) /* Τέλος recent.forEach */ %>
                        <% } else { /* Αν δεν υπάρχουν πρόσφατες */ %>
                            <div class="p-4 text-center text-muted small">
                                Δεν υπάρχουν πρόσφατες εισαγωγές.
                            </div>
                        <% } /* Τέλος if recent.length */ %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>