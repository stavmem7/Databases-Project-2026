<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Ασθενείς | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .custom-navbar { background-color: rgba(255, 255, 255, 0.95); border-bottom: 4px solid #0056b3; box-shadow: 0 4px 10px rgba(0,0,0,0.1); } /* Τέλος αγκύλης .custom-navbar */
    </style>
</head>
<body class="bg-light">
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <% if (role === 'doctor' /* Ελεγχος γιατρού */) { %>
                    <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                    <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                    <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                    <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                <% } /* Τέλος if doctor */ else if (role === 'nurse' /* Ελεγχος νοσηλευτή */) { %>
                    <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                    <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                    <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                <% } /* Τέλος else if nurse */ %>
                <li class="nav-item">
                    <a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

    <div class="container mt-4">
        <h2 class="mb-4 fw-bold text-dark">Μητρώο Ασθενών</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm bg-white rounded">
                <thead class="table-dark">
                    <tr>
                        <th>ΑΜΚΑ</th>
                        <th>Όνομα</th>
                        <th>Επώνυμο</th>
                        <th>Ηλικία</th>
                        <th>Ασφάλεια</th>
                    </tr>
                </thead>
                <tbody>
                    <% patients.forEach(p => { /* Έναρξη forEach ασθενών */ %>
                    <tr>
                        <td class="fw-bold"><%= p.ssn %></td>
                        <td><%= p.name %></td>
                        <td><%= p.surname %></td>
                        <td><%= p.age %></td>
                        <td><span class="badge bg-info text-dark"><%= p.insurance_provider %></span></td>
                    </tr>
                    <% }) /* Τέλος forEach ασθενών */ %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>