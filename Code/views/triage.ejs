<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Triage | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; padding-bottom: 50px; } /* Τέλος αγκύλης body */
        .urgency-1 { border-left: 10px solid #dc3545; background-color: #fff5f5; } /* Τέλος αγκύλης .urgency-1 */
        .urgency-2 { border-left: 10px solid #fd7e14; background-color: #fffaf5; } /* Τέλος αγκύλης .urgency-2 */
        .urgency-3 { border-left: 10px solid #ffc107; background-color: #fffdf5; } /* Τέλος αγκύλης .urgency-3 */
        .urgency-4 { border-left: 10px solid #0dcaf0; background-color: #f5fcff; } /* Τέλος αγκύλης .urgency-4 */
        .urgency-5 { border-left: 10px solid #198754; background-color: #f5fff8; } /* Τέλος αγκύλης .urgency-5 */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Έλεγχος γιατρού 1 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } /* Τέλος if doctor 1 */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Έλεγχος προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if doctor || nurse */ %>

                    <% if (role === 'doctor' /* Έλεγχος γιατρού 2 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor 2 */ %>

                    <% if (role === 'patient' /* Έλεγχος ασθενή */) { %>
                        <li class="nav-item"><a class="nav-link" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } /* Τέλος if patient */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul> </div> </div> </nav> <div class="container mt-4">
        <% if (typeof error !== 'undefined' && error === 'invalid_id' || error === 'invalid_nurse') { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-5" role="alert">
                <strong>Σφάλμα Καταχώρησης!</strong> Το SSN του Νοσηλευτή δεν βρέθηκε στο σύστημα.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error === 'patient_not_found') { %>
            <div class="alert alert-warning alert-dismissible fade show shadow-sm border-start border-warning border-5" role="alert">
                <strong>Ο ασθενής δεν βρέθηκε!</strong> Το SSN <strong><%= patient_ssn %></strong> δεν αντιστοιχεί σε υπάρχοντα ασθενή.
                Συμπληρώστε τα στοιχεία του παρακάτω για να τον καταχωρήσετε και να συνεχίσετε με τη διαλογή.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-dark fw-bold">Ουρά Αναμονής Επειγόντων</h2>
            <button class="btn btn-danger shadow" data-bs-toggle="modal" data-bs-target="#newTriageModal">
                <i class="bi bi-plus-circle me-2"></i>Νέα Διαλογή
            </button> </div> <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Άφιξη</th>
                        <th>Ασθενής</th>
                        <th>Επίπεδο</th>
                        <th>Συμπτώματα</th>
                        <th>Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cases.length > 0 /* Έλεγχος αν υπάρχουν περιστατικά */) { %>
                        <% cases.forEach(c => { /* Έναρξη forEach cases */ %>
                            <tr class="urgency-<%= c.urgency_level %>">
                                <td class="fw-bold"><%= new Date(c.arrival_time /* Τέλος Date */).toLocaleTimeString('el-GR' /* Τέλος locale */) %></td>
                                <td><%= c.name %> <%= c.surname %></td>
                                <td><span class="badge rounded-pill bg-dark">L<%= c.urgency_level %></span></td>
                                <td><small><%= c.symptoms %></small></td>
                                <td>
                                    <a href="/admission/<%= c.triage_id %>?role=<%= role %>" class="btn btn-sm btn-success shadow-sm">Εισαγωγή</a>
                                </td> </tr> <% }); /* Τέλος cases.forEach */ %>
                    <% } else { /* Αν η ουρά είναι άδεια */ %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Δεν υπάρχουν ασθενείς στην ουρά αναμονής.</td>
                        </tr> <% } /* Τέλος if cases.length */ %>
                </tbody> </table> </div> </div> <div class="modal fade" id="newTriageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Νέα Καταγραφή Περιστατικού</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div> <form action="/triage/new?role=<%= role %>" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">SSN Ασθενούς (AMKA)</label>
                            <input type="text" name="patient_ssn" class="form-control" required maxlength="11">
                        </div> <div class="mb-3">
                            <label class="form-label fw-bold">SSN Νοσηλευτή Διαλογής</label>
                            <input type="text" name="nurse_ssn" class="form-control" required maxlength="11">
                        </div> <div class="mb-3">
                            <label class="form-label fw-bold">Επίπεδο Επείγοντος</label>
                            <select name="urgency_level" class="form-select" required>
                                <option value="1">1 - Άμεσο (Κόκκινο)</option>
                                <option value="2">2 - Πολύ Επείγον (Πορτοκαλί)</option>
                                <option value="3">3 - Επείγον (Κίτρινο)</option>
                                <option value="4">4 - Λιγότερο Επείγον (Μπλε)</option>
                                <option value="5">5 - Μη Επείγον (Πράσινο)</option>
                            </select> </div> <div class="mb-3">
                            <label class="form-label fw-bold">Συμπτώματα</label>
                            <textarea name="symptoms" class="form-control" rows="3"></textarea>
                        </div> </div> <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Άκυρο</button>
                        <button type="submit" class="btn btn-success px-4">Καταχώρηση</button>
                    </div> </form> </div> </div> </div> <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Modal: Register New Patient + Triage -->
<div class="modal fade" id="registerPatientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="bi bi-person-plus-fill me-2"></i>Εγγραφή Νέου Ασθενούς & Διαλογή</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/triage/register-patient?role=<%= role %>" method="POST">
                <!-- Hidden triage fields carried over -->
                <input type="hidden" name="patient_ssn" value="<%= patient_ssn %>">
                <input type="hidden" name="nurse_ssn"   value="<%= nurse_ssn %>">
                <input type="hidden" name="urgency_level" value="<%= urgency_level %>">
                <input type="hidden" name="symptoms"    value="<%= symptoms %>">
                <input type="hidden" name="role"        value="<%= role %>">

                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        AMKA Ασθενούς: <strong><%= patient_ssn %></strong> &mdash;
                        Επίπεδο Επείγοντος: <strong>L<%= urgency_level %></strong>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Όνομα <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Επώνυμο <span class="text-danger">*</span></label>
                            <input type="text" name="surname" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Πατρώνυμο</label>
                            <input type="text" name="father_name" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Ηλικία <span class="text-danger">*</span></label>
                            <input type="number" name="age" class="form-control" min="0" max="150" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Φύλο <span class="text-danger">*</span></label>
                            <select name="gender" class="form-select" required>
                                <option value="">-- Επιλογή --</option>
                                <option value="MALE">Άνδρας</option>
                                <option value="FEMALE">Γυναίκα</option>
                                <option value="OTHER">Άλλο</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Βάρος (kg)</label>
                            <input type="number" name="weight" class="form-control" step="0.1" min="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Ύψος (cm)</label>
                            <input type="number" name="height" class="form-control" step="0.1" min="0">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Διεύθυνση</label>
                            <input type="text" name="address" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Τηλέφωνο</label>
                            <input type="text" name="phone" class="form-control">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="email" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Επάγγελμα</label>
                            <input type="text" name="occupation" class="form-control">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Εθνικότητα</label>
                            <input type="text" name="nationality" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ασφαλιστικός Φορέας</label>
                            <input type="text" name="insurance_provider" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <a href="/triage?role=<%= role %>" class="btn btn-secondary">Άκυρο</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold">
                        <i class="bi bi-person-check-fill me-1"></i>Καταχώρηση Ασθενούς & Διαλογή
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Auto-open the register modal if redirected back with patient_not_found
    <% if (typeof error !== 'undefined' && error === 'patient_not_found') { %>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('registerPatientModal'));
            modal.show();
        });
    <% } %>
</script>
</body> </html>