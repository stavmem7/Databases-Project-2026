<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Triage | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; padding-bottom: 50px; } /* Τέλος αγκύλης body */
        .urgency-1 { border-left: 10px solid #dc3545; background-color: #fff5f5; } /* Τέλος αγκύλης .urgency-1 */
        .urgency-2 { border-left: 10px solid #fd7e14; background-color: #fffaf5; } /* Τέλος αγκύλης .urgency-2 */
        .urgency-3 { border-left: 10px solid #ffc107; background-color: #fffdf5; } /* Τέλος αγκύλης .urgency-3 */
        .urgency-4 { border-left: 10px solid #0dcaf0; background-color: #f5fcff; } /* Τέλος αγκύλης .urgency-4 */
        .urgency-5 { border-left: 10px solid #198754; background-color: #f5fff8; } /* Τέλος αγκύλης .urgency-5 */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Έλεγχος γιατρού 1 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } /* Τέλος if doctor 1 */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Έλεγχος προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if doctor || nurse */ %>

                    <% if (role === 'doctor' /* Έλεγχος γιατρού 2 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor 2 */ %>

                    <% if (role === 'patient' /* Έλεγχος ασθενή */) { %>
                        <li class="nav-item"><a class="nav-link" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } /* Τέλος if patient */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul> </div> </div> </nav> <div class="container mt-4">
        <% if (typeof error !== 'undefined' && error === 'invalid_id' /* Έλεγχος σφάλματος */) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-5" role="alert">
                <strong>Σφάλμα Καταχώρησης!</strong> Το SSN του Ασθενούς ή του Νοσηλευτή δεν βρέθηκε στο σύστημα.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div> <% } /* Τέλος if error */ %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-dark fw-bold">Ουρά Αναμονής Επειγόντων</h2>
            <button class="btn btn-danger shadow" data-bs-toggle="modal" data-bs-target="#newTriageModal">
                <i class="bi bi-plus-circle me-2"></i>Νέα Διαλογή
            </button> </div> <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Άφιξη</th>
                        <th>Ασθενής</th>
                        <th>Επίπεδο</th>
                        <th>Συμπτώματα</th>
                        <th>Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cases.length > 0 /* Έλεγχος αν υπάρχουν περιστατικά */) { %>
                        <% cases.forEach(c => { /* Έναρξη forEach cases */ %>
                            <tr class="urgency-<%= c.urgency_level %>">
                                <td class="fw-bold"><%= new Date(c.arrival_time /* Τέλος Date */).toLocaleTimeString('el-GR' /* Τέλος locale */) %></td>
                                <td><%= c.name %> <%= c.surname %></td>
                                <td><span class="badge rounded-pill bg-dark">L<%= c.urgency_level %></span></td>
                                <td><small><%= c.symptoms %></small></td>
                                <td>
                                    <a href="/admission/<%= c.triage_id %>?role=<%= role %>" class="btn btn-sm btn-success shadow-sm">Εισαγωγή</a>
                                </td> </tr> <% }); /* Τέλος cases.forEach */ %>
                    <% } else { /* Αν η ουρά είναι άδεια */ %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Δεν υπάρχουν ασθενείς στην ουρά αναμονής.</td>
                        </tr> <% } /* Τέλος if cases.length */ %>
                </tbody> </table> </div> </div> <div class="modal fade" id="newTriageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Νέα Καταγραφή Περιστατικού</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div> <form action="/triage/new?role=<%= role %>" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">SSN Ασθενούς (AMKA)</label>
                            <input type="text" name="patient_ssn" class="form-control" required maxlength="11">
                        </div> <div class="mb-3">
                            <label class="form-label fw-bold">SSN Νοσηλευτή Διαλογής</label>
                            <input type="text" name="nurse_ssn" class="form-control" required maxlength="11">
                        </div> <div class="mb-3">
                            <label class="form-label fw-bold">Επίπεδο Επείγοντος</label>
                            <select name="urgency_level" class="form-select" required>
                                <option value="1">1 - Άμεσο (Κόκκινο)</option>
                                <option value="2">2 - Πολύ Επείγον (Πορτοκαλί)</option>
                                <option value="3">3 - Επείγον (Κίτρινο)</option>
                                <option value="4">4 - Λιγότερο Επείγον (Μπλε)</option>
                                <option value="5">5 - Μη Επείγον (Πράσινο)</option>
                            </select> </div> <div class="mb-3">
                            <label class="form-label fw-bold">Συμπτώματα</label>
                            <textarea name="symptoms" class="form-control" rows="3"></textarea>
                        </div> </div> <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Άκυρο</button>
                        <button type="submit" class="btn btn-success px-4">Καταχώρηση</button>
                    </div> </form> </div> </div> </div> <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body> </html>