<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Εργαστηριακές Εξετάσεις | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .test-card { border-radius: 12px; border: none; transition: 0.2s; } /* Τέλος αγκύλης .test-card */
        .test-card:hover { transform: scale(1.01 /* Τέλος scale */); } /* Τέλος αγκύλης .test-card:hover */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Πίσω στις Νοσηλείες</a></li>
                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul> </div> </div> </nav> <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark"><i class="bi bi-microscope me-2"></i>Εξετάσεις Νοσηλείας #<%= hosp_id %></h2>
        </div> <% if (tests.length > 0 /* Έλεγχος αν υπάρχουν εξετάσεις */) { %>
            <div class="row">
                <% tests.forEach(t => { /* Έναρξη forEach εξετάσεων */ %>
                    <div class="col-md-6 mb-3">
                        <div class="card test-card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold text-primary mb-0"><%= t.type %></h5>
                                    <span class="badge bg-light text-dark border"><%= t.code %></span>
                                </div> <p class="text-muted small mb-3"><i class="bi bi-calendar3 me-1"></i><%= new Date(t.date /* Τέλος Date */).toLocaleDateString('el-GR' /* Τέλος locale */) %></p>
                                
                                <div class="p-3 bg-light rounded border">
                                    <span class="text-muted small d-block mb-1 text-uppercase fw-bold">Αποτέλεσμα:</span>
                                    <span class="fs-5 fw-bold">
                                        <% if (t.result_numeric /* Έλεγχος αν υπάρχει αριθμητικό αποτέλεσμα */) { %>
                                            <%= t.result_numeric %> <small class="text-muted"><%= t.unit %></small>
                                        <% } else if (t.result_text /* Έλεγχος αν υπάρχει κείμενο */) { %>
                                            <%= t.result_text %>
                                        <% } else { /* Αν δεν υπάρχει τίποτα */ %>
                                            Εκκρεμεί...
                                        <% } /* Τέλος if results */ %>
                                    </span>
                                </div> </div> </div> </div> <% }); /* Τέλος tests.forEach */ %>
            </div> <% } else { /* Αν δεν υπάρχουν εξετάσεις */ %>
            <div class="alert alert-info shadow-sm text-center py-5">
                <i class="bi bi-clipboard-x display-4 d-block mb-3"></i>
                Δεν έχουν καταχωρηθεί εργαστηριακές εξετάσεις για αυτή τη νοσηλεία.
            </div> <% } /* Τέλος αν tests.length */ %>
    </div> <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body> </html> 