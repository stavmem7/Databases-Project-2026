<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Προσωπικό | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .table-container { background: white; padding: 25px; border-radius: 15px; } /* Τέλος αγκύλης .table-container */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Έλεγχος γιατρού 1 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } /* Τέλος if doctor 1 */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Έλεγχος προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if doctor || nurse */ %>

                    <% if (role === 'doctor' /* Έλεγχος γιατρού 2 */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor 2 */ %>

                    <% if (role === 'patient' /* Έλεγχος ασθενή */) { %>
                        <li class="nav-item"><a class="nav-link" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } /* Τέλος if patient */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="table-container shadow-sm">
            <h2 class="mb-4 text-primary fw-bold">Ιατρικό Προσωπικό</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Όνομα</th>
                            <th>Επώνυμο</th>
                            <th>Ειδικότητα</th>
                            <th>Βαθμίδα</th>
                            <th>Αρ. Αδείας</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% doctors.forEach(doc => { /* Έναρξη forEach γιατρών */ %>
                            <tr>
                                <td class="fw-bold"><%= doc.name %></td>
                                <td><%= doc.surname %></td>
                                <td><span class="badge bg-info text-dark"><%= doc.specialty %></span></td>
                                <td><%= doc.rank %></td>
                                <td><code><%= doc.medical_license_no %></code></td>
                            </tr>
                        <% }); /* Τέλος doctors.forEach */ %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>