<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Το Ιστορικό μου | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .history-card { border-radius: 15px; border-left: 5px solid #0d6efd; transition: 0.3s; border-top: none; border-right: none; border-bottom: none; } /* Τέλος αγκύλης .history-card */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'patient' /* Έλεγχος αν είναι ασθενής για το navbar */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/#search-ssn">Το Ιστορικό μου</a></li>
                    <% } /* Τέλος if patient */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/?role=<%= role %>" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-2"></i>Πίσω στην Αρχική</a>
            <h2 class="fw-bold mb-0 text-dark">Καρτέλα Ασθενούς</h2>
        </div>

        <% if (!patient /* Έλεγχος αν βρέθηκε ο ασθενής */) { %>
            <div class="alert alert-danger shadow-sm text-center border-0" style="border-radius: 15px;">
                <i class="bi bi-exclamation-octagon fs-4 d-block mb-2"></i>
                Δεν βρέθηκε ασθενής με το ΑΜΚΑ: <strong><%= ssn %></strong>
            </div>
        <% } else { /* Αν βρέθηκε ο ασθενής */ %>
            <div class="card shadow-sm p-4 mb-4 border-0 bg-primary text-white" style="border-radius: 20px;">
                <h4 class="mb-0 text-uppercase">Ιστορικό Νοσηλειών: <strong><%= patient.name %> <%= patient.surname %></strong></h4>
            </div>

            <div class="row">
                <% if (history && history.length > 0 /* Έλεγχος αν υπάρχει ιστορικό */) { %>
                    <% history.forEach(h => { /* Έναρξη forEach ιστορικού */ %>
                        <div class="col-12 mb-3">
                            <div class="card history-card shadow-sm p-3 bg-white">
                                <div class="row align-items-center">
                                    <div class="col-md-3 border-end">
                                        <div class="small text-muted text-uppercase fw-bold">Εισαγωγή</div>
                                        <div class="fw-bold text-primary fs-5">
                                            <%= h.admission_date ? new Date(h.admission_date /* Τέλος Date */).toLocaleDateString('el-GR' /* Τέλος locale */) : '---' %>
                                        </div>
                                        <div class="small text-muted mt-2 text-uppercase fw-bold">Εξιτήριο</div>
                                        <div class="fw-bold fs-5 text-dark">
                                            <%= h.discharge_date ? new Date(h.discharge_date /* Τέλος Date 2 */).toLocaleDateString('el-GR' /* Τέλος locale 2 */) : 'Σε εξέλιξη' %>
                                        </div>
                                    </div>
                                    <div class="col-md-9 ps-4">
                                        <h5 class="fw-bold mb-1 text-primary"><%= h.dept_name %></h5>
                                        <p class="mb-0 text-dark">
                                            <span class="text-muted fw-bold small text-uppercase">Διάγνωση:</span> <br>
                                            <%= h.admission_diagnosis_desc || 'Δεν έχει καταχωρηθεί περιγραφή' %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); /* Τέλος history.forEach */ %>
                <% } else { /* Αν δεν βρέθηκαν νοσηλείες */ %>
                    <div class="col-12 text-center p-5 bg-white rounded shadow-sm">
                        <i class="bi bi-calendar-x display-4 text-muted"></i>
                        <p class="text-muted mt-3">Δεν βρέθηκαν παλαιότερες νοσηλείες για αυτό το ΑΜΚΑ.</p>
                    </div>
                <% } /* Τέλος if history.length */ %>
            </div>
        <% } /* Τέλος if patient else */ %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>