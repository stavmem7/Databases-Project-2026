<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Νέα Συνταγή | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f4f7f6; padding-top: 80px; } /* Τέλος αγκύλης body */
        .prescription-card { border-radius: 15px; border: none; } /* Τέλος αγκύλης .prescription-card */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Έλεγχος γιατρού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor */ %>
                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul> </div> </div> </nav> <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card prescription-card shadow-lg p-4">
                    <h3 class="text-success mb-4 fw-bold"><i class="bi bi-capsule-pill me-2"></i>Νέα Συνταγογράφηση</h3>
                    
                    <% if (error === 'allergy' /* Έλεγχος αλλεργίας */) { %>
                        <div class="alert alert-danger border-start border-5 border-danger shadow-sm">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>ΠΡΟΣΟΧΗ:</strong> Ο ασθενής έχει αλλεργία στην ουσία: <strong><%= substance %></strong>
                        </div> <% } /* Τέλος if error */ %>

                    <div class="alert alert-secondary border-0 shadow-sm">
                        <i class="bi bi-person-badge me-2"></i><strong>Ασθενής:</strong> <%= hosp.name %> <%= hosp.surname %> (SSN: <%= hosp.ssn %>)<br>
                        <i class="bi bi-hospital me-2"></i><strong>ID Νοσηλείας:</strong> #<%= hosp.hospitalization_id %>
                    </div> <form action="/prescription/save?role=<%= role %>" method="POST">
                        <input type="hidden" name="hospitalization_id" value="<%= hosp.hospitalization_id %>">
                        <input type="hidden" name="patient_ssn" value="<%= hosp.ssn %>">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Επιβλέπων Ιατρός</label>
                            <select name="doctor_ssn" class="form-select shadow-sm" required>
                                <% doctors.forEach(doc => { /* Έναρξη forEach ιατρών */ %>
                                    <option value="<%= doc.ssn %>">Δρ. <%= doc.surname %> (SSN: <%= doc.ssn %>)</option>
                                <% }) /* Τέλος doctors.forEach */ %>
                            </select> </div> <div class="mb-3">
                            <label class="form-label fw-bold">Επιλογή Φαρμάκου</label>
                            <select name="medication_id" class="form-select shadow-sm" required>
                                <% meds.forEach(m => { /* Έναρξη forEach φαρμάκων */ %>
                                    <option value="<%= m.medication_id %>"><%= m.name %></option>
                                <% }) /* Τέλος meds.forEach */ %>
                            </select> </div> <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Δοσολογία</label>
                                <input type="text" name="dosage" class="form-control shadow-sm" placeholder="π.χ. 500mg" required>
                            </div> <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Συχνότητα</label>
                                <input type="text" name="frequency" class="form-control shadow-sm" placeholder="π.χ. 3 φορές την ημέρα" required>
                            </div> </div> <hr class="my-4">
                        <div class="d-flex justify-content-between">
                            <a href="/hospitalizations?role=<%= role %>" class="btn btn-secondary px-4">Ακύρωση</a>
                            <button type="submit" class="btn btn-success px-5 shadow fw-bold">Καταχώρηση Συνταγής</button>
                        </div> </form> </div> </div> </div> </div> <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body> </html> 