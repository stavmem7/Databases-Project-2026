<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Νοσηλείες | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; padding-top: 80px; } /* Τέλος αγκύλης body */
        .table-container { background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1 /* Τέλος rgba */); } /* Τέλος αγκύλης .table-container */
        .btn-action { margin: 0 2px; } /* Τέλος αγκύλης .btn-action */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Navbar Γιατρού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } else { /* Navbar Νοσηλευτή */ %>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if role */ %>
                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul> </div> </div> </nav> <div class="container mt-4">
        <h2 class="text-primary fw-bold mb-4">Ενεργές Νοσηλείες</h2>
        
        <div class="table-responsive table-container">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Ασθενής</th>
                        <th>Τμήμα</th>
                        <th>Κρεβάτι</th>
                        <th>Εισαγωγή</th>
                        <th class="text-center">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (admissions && admissions.length > 0 /* Έλεγχος */) { %>
                        <% admissions.forEach(h => { /* Έναρξη loop */ %>
                            <tr>
                                <td class="ps-4 text-muted">#<%= h.hospitalization_id %></td>
                                <td class="fw-bold"><%= h.name %> <%= h.surname %></td>
                                <td><%= h.dept_name %></td>
                                <td><span class="badge bg-secondary">No. <%= h.bed_no %></span></td>
                                <td><%= new Date(h.admission_date /* Τέλος Date */).toLocaleDateString('el-GR' /* Τέλος locale */) %></td>
                                <td class="text-center">
                                    
                                    <% if (role === 'doctor' /* Κουμπί Συνταγής */) { %>
                                        <a href="/prescription/new/<%= h.hospitalization_id %>?role=<%= role %>" class="btn btn-sm btn-outline-primary btn-action" title="Συνταγή">
                                            <i class="bi bi-capsule"></i>
                                        </a>
                                    <% } /* Τέλος if doctor 1 */ %>

                                    <a href="/hospitalizations/<%= h.hospitalization_id %>/tests?role=<%= role %>" class="btn btn-sm btn-outline-info btn-action" title="Εξετάσεις">
                                        <i class="bi bi-envelope-paper-heart"></i>
                                    </a>

                                    <% if (role === 'doctor' /* Κουμπί Εξιτηρίου με JS */) { %>
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-action" title="Εξιτήριο" onclick="handleDischarge('<%= h.hospitalization_id %>', '<%= role %>')">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </button>
                                    <% } /* Τέλος if doctor 2 */ %>

                                </td> </tr> <% }); /* Τέλος forEach */ %>
                    <% } else { /* Empty */ %>
                        <tr><td colspan="6" class="text-center py-5 text-muted">Δεν υπάρχουν ενεργές νοσηλείες.</td></tr>
                    <% } /* Τέλος if admissions */ %>
                </tbody> </table> </div> </div> <form id="dischargeForm" method="POST" style="display: none;"></form>

    <script>
        function handleDischarge(hospId, role) {
            if (confirm('Επιβεβαίωση έκδοσης εξιτηρίου;' /* Τέλος confirm */)) {
                const form = document.getElementById('dischargeForm' /* Τέλος getElement */);
                form.action = '/discharge/' + hospId + '?role=' + role;
                form.submit();
            } /* Τέλος if confirm */
        } /* Τέλος handleDischarge */
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body> </html>