<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Φαρμακείο | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .custom-navbar { background-color: rgba(255, 255, 255, 0.95); border-bottom: 4px solid #0056b3; }
        .navbar-brand { font-weight: 700; color: #003366 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg custom-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/patients">Ασθενείς</a></li>
                    <li class="nav-item"><a class="nav-link" href="/staff">Προσωπικό</a></li>
                    <li class="nav-item"><a class="nav-link" href="/departments">Τμήματα</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" href="/pharmacy">Φαρμακείο</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4 text-success">Αποθέματα Φαρμακείου</h2>
        <div class="table-responsive bg-white p-3 rounded shadow-sm">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Ονομασία Φαρμάκου</th>
                        <th>Κωδικός ΕΜΑ</th>
                        <th>Δραστικές Ουσίες</th>
                    </tr>
                </thead>
                <tbody>
                    <% medications.forEach(med => { %>
                        <tr>
                            <td class="fw-bold"><%= med.medication_name %></td>
                            <td><code><%= med.ema_code %></code></td>
                            <td><span class="badge bg-info text-dark"><%= med.substances || 'N/A' %></span></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>