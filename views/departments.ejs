<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Τμήματα | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .custom-navbar { background-color: rgba(255, 255, 255, 0.95); border-bottom: 4px solid #0056b3; }
        .navbar-brand { font-weight: 700; color: #003366 !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg custom-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/patients">Ασθενείς</a></li>
                    <li class="nav-item"><a class="nav-link" href="/staff">Προσωπικό</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" href="/departments">Τμήματα</a></li>
                    <li class="nav-item"><a class="nav-link" href="/pharmacy">Φαρμακείο</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4 text-primary">Νοσοκομειακά Τμήματα</h2>
        <div class="row">
            <% departments.forEach(dept => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark"><%= dept.name %></h5>
                            <p class="card-text">
                                <strong>Κτήριο/Όροφος:</strong> <%= dept.floor_building %><br>
                                <strong>Κλίνες:</strong> <%= dept.bed_count %><br>
                                <strong>Διευθυντής:</strong> <%= dept.director_name || 'Δεν έχει οριστεί' %>
                            </p>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</body>
</html>