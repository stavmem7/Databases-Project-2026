<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Εισαγωγή Ασθενούς | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f4f7f6; padding-top: 80px; } /* Τέλος αγκύλης body */
        .admission-card { border-radius: 15px; border: none; } /* Τέλος αγκύλης .admission-card */
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Έλεγχος γιατρού 1 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li>
                    <% } /* Τέλος if doctor 1 */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Έλεγχος προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link active fw-bold" href="/triage?role=<%= role %>">Triage</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li>
                        <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li>
                    <% } /* Τέλος if doctor || nurse */ %>

                    <% if (role === 'doctor' /* Έλεγχος γιατρού 2 */) { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li>
                        <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li>
                    <% } /* Τέλος if doctor 2 */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 px-3 text-white" href="/">Έξοδος</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card admission-card shadow-lg p-4">
                    <h3 class="text-primary mb-4 fw-bold">Φόρμα Εισαγωγής Ασθενούς</h3>
                    <div class="alert alert-info border-0 shadow-sm">
                        <i class="bi bi-person-circle me-2"></i><strong>Ασθενής:</strong> <%= triage.name %> <%= triage.surname %> (SSN: <%= triage.patient_ssn %>)<br>
                        <i class="bi bi-clipboard2-pulse me-2"></i><strong>Συμπτώματα:</strong> <%= triage.symptoms %>
                    </div>

                    <form action="/admission/complete?role=<%= role %>" method="POST">
                        <input type="hidden" name="triage_id" value="<%= triage.triage_id %>">
                        <input type="hidden" name="patient_ssn" value="<%= triage.patient_ssn %>">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Επιλογή Διαθέσιμης Κλίνης</label>
                            <select name="bed_id" class="form-select shadow-sm" required>
                                <% beds.forEach(bed => { /* Έναρξη forEach κλινών */ %>
                                    <option value="<%= bed.bed_id %>">
                                        <%= bed.dept_name %> - Κρεβάτι: <%= bed.unique_number %>
                                    </option>
                                <% }) /* Τέλος beds.forEach */ %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Κωδικός ΚΕΝ (DRG)</label>
                            <select name="ken_code" class="form-select shadow-sm" required>
                                <% kenCodes.forEach(k => { /* Έναρξη forEach KEN */ %>
                                    <option value="<%= k.ken_code %>"><%= k.ken_code %> - <%= k.description %></option>
                                <% }) /* Τέλος kenCodes.forEach */ %>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Κωδικός ICD10</label>
                                <select name="diagnosis_code" class="form-select shadow-sm" required>
                                    <% icd10.forEach(i => { /* Έναρξη forEach ICD10 */ %>
                                        <option value="<%= i.code %>"><%= i.code %></option>
                                    <% }) /* Τέλος icd10.forEach */ %>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold">Περιγραφή Διάγνωσης</label>
                                <input type="text" name="diagnosis_desc" class="form-control shadow-sm" required placeholder="Πληκτρολογήστε τη διάγνωση...">
                            </div>
                        </div>

                        <hr class="my-4">
                        <div class="d-flex justify-content-between">
                            <a href="/triage?role=<%= role %>" class="btn btn-secondary px-4">Ακύρωση</a>
                            <button type="submit" class="btn btn-primary px-5 shadow fw-bold">Ολοκλήρωση Εισαγωγής</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>