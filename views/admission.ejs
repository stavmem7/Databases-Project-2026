<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Εισαγωγή Ασθενούς | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; }
        .custom-navbar { background-color: white; border-bottom: 3px solid #0056b3; }
        .admission-card { border-radius: 15px; border: none; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg custom-navbar mb-4">
        <div class="container"><a class="navbar-brand fw-bold" href="/" style="color: #003366;">YGEIOPOLIS</a></div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card admission-card shadow-lg p-4">
                    <h3 class="text-primary mb-4">Φόρμα Εισαγωγής Ασθενούς</h3>
                    <div class="alert alert-info">
                        <strong>Ασθενής:</strong> <%= triage.name %> <%= triage.surname %> (SSN: <%= triage.patient_ssn %>)<br>
                        <strong>Συμπτώματα:</strong> <%= triage.symptoms %>
                    </div>

                    <form action="/admission/complete" method="POST">
                        <input type="hidden" name="triage_id" value="<%= triage.triage_id %>">
                        <input type="hidden" name="patient_ssn" value="<%= triage.patient_ssn %>">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Επιλογή Διαθέσιμης Κλίνης</label>
                            <select name="bed_id" class="form-select" required>
                                <% beds.forEach(bed => { %>
                                    <option value="<%= bed.bed_id %>">
                                        <%= bed.dept_name %> - Κρεβάτι: <%= bed.unique_number %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Κωδικός ΚΕΝ (DRG)</label>
                            <select name="ken_code" class="form-select" required>
                                <% kenCodes.forEach(k => { %>
                                    <option value="<%= k.ken_code %>"><%= k.ken_code %> - <%= k.description %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Κωδικός ICD10</label>
                                <select name="diagnosis_code" class="form-select" required>
                                    <% icd10.forEach(i => { %>
                                        <option value="<%= i.code %>"><%= i.code %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold">Περιγραφή Διάγνωσης</label>
                                <input type="text" name="diagnosis_desc" class="form-control" required>
                            </div>
                        </div>

                        <hr class="my-4">
                        <div class="d-flex justify-content-between">
                            <a href="/triage" class="btn btn-secondary">Ακύρωση</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">Ολοκλήρωση Εισαγωγής</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>