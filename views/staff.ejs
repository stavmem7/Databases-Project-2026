<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Προσωπικό | Υγειόπολις</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; font-family: 'Roboto', sans-serif; }
        .custom-navbar {
            background-color: rgba(255, 255, 255, 0.95);
            border-bottom: 4px solid #0056b3;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        .navbar-brand { font-weight: 700; color: #003366 !important; }
        .table-container { margin-top: 50px; background: white; padding: 20px; border-radius: 15px; shadow: 0 4px 15px rgba(0,0,0,0.1); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg custom-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">YGEIOPOLIS</a>
            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/patients">Ασθενείς</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" href="/staff">Προσωπικό</a></li>
                    <li class="nav-item"><a class="nav-link" href="/departments">Τμήματα</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="table-container shadow-sm">
            <h2 class="mb-4 text-primary">Ιατρικό Προσωπικό</h2>
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Όνομα</th>
                        <th>Επώνυμο</th>
                        <th>Ειδικότητα</th>
                        <th>Βαθμίδα</th>
                        <th>Αρ. Αδείας</th>
                    </tr>
                </thead>
                <tbody>
                    <% doctors.forEach(doc => { %>
                        <tr>
                            <td><%= doc.name %></td>
                            <td><%= doc.surname %></td>
                            <td><%= doc.specialty %></td>
                            <td><%= doc.rank %></td>
                            <td><%= doc.medical_license_no %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>