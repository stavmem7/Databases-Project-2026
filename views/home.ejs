<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <title>Υγειόπολις | Αρχική</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .hero-section {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            height: 100vh;
            color: white;
        } /* Τέλος αγκύλης .hero-section */
        .role-selection-overlay {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 9999;
            display: flex; align-items: center; justify-content: center;
        } /* Τέλος αγκύλης .role-selection-overlay */
        .role-card { transition: 0.3s; cursor: pointer; border-radius: 15px; } /* Τέλος αγκύλης .role-card */
        .role-card:hover { transform: translateY(-10px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); } /* Τέλος αγκύλης .role-card:hover */
    </style>
</head>
<body>

    <% if (!role /* Έλεγχος αν δεν έχει επιλεγεί ρόλος */) { %>
    <div class="role-selection-overlay">
        <div class="container text-center">
            <h1 class="mb-5 fw-bold text-dark">Καλώς ορίσατε στο <span class="text-primary">Υγειόπολις</span></h1>
            <div class="row g-4 justify-content-center">
                <div class="col-md-3">
                    <a href="/?role=doctor" class="text-decoration-none text-dark">
                        <div class="card role-card p-4 shadow-sm">
                            <i class="bi bi-person-badge fs-1 text-success mb-3"></i>
                            <h5>Ιατρός</h5>
                        </div> </a> </div> <div class="col-md-3">
                    <a href="/?role=nurse" class="text-decoration-none text-dark">
                        <div class="card role-card p-4 shadow-sm">
                            <i class="bi bi-bandaid fs-1 text-info mb-3"></i>
                            <h5>Νοσηλευτής</h5>
                        </div> </a> </div> <div class="col-md-3">
                    <a href="/?role=patient" class="text-decoration-none text-dark">
                        <div class="card role-card p-4 shadow-sm">
                            <i class="bi bi-person-heart fs-1 text-success mb-3"></i>
                            <h5>Ασθενής</h5>
                        </div> </a> </div> </div> </div> </div> <% } /* Τέλος ελέγχου !role */ %>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/?role=<%= role %>">YGEIOPOLIS</a> <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <% if (role === 'doctor' /* Επιλογές γιατρού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard?role=<%= role %>">Dashboard</a></li> <li class="nav-item"><a class="nav-link" href="/patients?role=<%= role %>">Ασθενείς</a></li> <% } /* Τέλος ελέγχου doctor */ %>

                    <% if (role === 'doctor' || role === 'nurse' /* Επιλογές προσωπικού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/triage?role=<%= role %>">Triage</a></li> <li class="nav-item"><a class="nav-link" href="/hospitalizations?role=<%= role %>">Νοσηλείες</a></li> <li class="nav-item"><a class="nav-link" href="/pharmacy?role=<%= role %>">Φαρμακείο</a></li> <% } /* Τέλος ελέγχου doctor || nurse */ %>

                    <% if (role === 'doctor' /* Πρόσθετα μενού γιατρού */) { %>
                        <li class="nav-item"><a class="nav-link" href="/staff?role=<%= role %>">Προσωπικό</a></li> <li class="nav-item"><a class="nav-link" href="/departments?role=<%= role %>">Τμήματα</a></li> <% } /* Τέλος ελέγχου doctor */ %>

                    <li class="nav-item"><a class="nav-link btn btn-outline-danger btn-sm ms-lg-3 text-white" href="/">Έξοδος</a></li> </ul> </div> </div> </nav> <div class="hero-section d-flex align-items-center justify-content-center text-center">
        <div class="container">
            <h1 class="display-2 fw-bold mb-3">Σύστημα Διαχείρισης Κλινικής</h1> <p class="lead mb-5">Ολοκληρωμένες λύσεις υγείας για το προσωπικό και τους ασθενείς μας.</p> <% if (role === 'patient' /* Εμφάνιση φόρμας αν ο ρόλος είναι ασθενής */) { %>
            <div id="search-ssn" class="card p-4 mx-auto shadow-lg" style="max-width: 500px; background: rgba(255,255,255,0.9); color: black; border-radius: 20px;">
                <h4 class="fw-bold mb-3">Αναζήτηση Ιστορικού</h4> <form action="/my-results" method="GET">
                    <input type="hidden" name="role" value="<%= role /* Διατήρηση του ρόλου patient στο επόμενο URL */ %>"> <input type="text" name="ssn" class="form-control mb-3 text-center" placeholder="Εισάγετε το ΑΜΚΑ σας" required> <button type="submit" class="btn btn-primary w-100">Προβολή Νοσηλειών</button> </form> </div> <% } /* Τέλος ελέγχου role === 'patient' */ %>
        </div> </div> </body> </html>